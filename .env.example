# ─────────────────────────────────────────────────────────────
# Vive Bien — variables de entorno
# Copia este archivo como .env.local y rellena los valores.
# .env* está en .gitignore: nunca subas el archivo con valores reales.
# ─────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────
# Base de datos principal desde 2026-04-01.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRETO DE SERVIDOR. Ignora las políticas RLS por completo.
# Sin prefijo NEXT_PUBLIC_ a propósito: si lo lleva, se filtra al navegador.
# Sólo se usa en rutas API después de validar la sesión con requireAdmin().
SUPABASE_SERVICE_ROLE_KEY=

# ── Firebase (sólo autenticación) ───────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Administración ──────────────────────────────────────────
# Autoridad real: la comprueba el servidor en cada ruta de administración.
# Lista separada por comas. Si queda vacía, TODA petición de administración
# se rechaza con 503 (falla cerrado, nunca abierto).
ADMIN_EMAILS=

# Misma lista, para que la interfaz sepa qué mostrar. No protege nada:
# es visible en el navegador por diseño.
NEXT_PUBLIC_ADMIN_EMAILS=

# ── Direccion publica ────────────────────────────────────────
# La usan sitemap, robots, canonical y las tarjetas de Open Graph.
# Sin ella cae a https://vivebienn.com
NEXT_PUBLIC_APP_URL=

# ── Contacto ────────────────────────────────────────────────
NEXT_PUBLIC_WA_NUMBER=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_ADMIN_EMAIL=

# ── Cloudinary (imágenes de propiedades) ────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
