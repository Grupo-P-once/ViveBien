+import { NextResponse } from 'next/server'
+import { leerFlagsConEstado } from '@/lib/config/flags-lectura'
+import { estadoDelPortal, respuestaPortalNoDisponible } from '@/lib/portal/no-disponible'
+
+/**
+ * Proxy de `/portal` (QA-019). Es el ÚNICO sitio donde se puede devolver un HTTP 503 para una página del portal: un layout de Next ya
+ * no puede cambiar el código de estado cuando empieza a transmitir (por eso `notFound()` es 404 y no hay un `unavailable()`).
+ *
+ * Hace una sola cosa: si la configuración del portal NO se pudo leer, responde 503 con un mensaje claro. En cualquier otro caso deja
+ * pasar la petición sin tocarla, y el layout y las APIs deciden como siempre (404 si está cerrado, sesión y permisos en cada API). No lee
+ * la sesión, no concede nada y no cambia ninguna decisión de acceso: un error aquí sólo puede traducirse en 503, nunca en abrir.
+ */
+export async function proxy() {
+  const lectura = await leerFlagsConEstado()
+  if (estadoDelPortal(lectura) === 'indisponible') return respuestaPortalNoDisponible()
+  return NextResponse.next()
+}
+
+export const config = {
+  matcher: ['/portal', '/portal/:path*'],
+}
