+
+  it('cerrado confirmado → 404 como siempre', async () => {
+    const r = await pedir()
+    expect(r.error!.status).toBe(404)
+    expect(bd.exigirLlamado).toBe(0)
+  })
+
+  it('abierto → sigue pasando por la sesión y los permisos (exigir)', async () => {
+    bd.valor = { portalCliente: true, portalClienteInterno: false }
+    const r = await pedir()
+    expect(r.error).toBeUndefined()
+    expect(bd.exigirLlamado).toBe(1)
+  })
