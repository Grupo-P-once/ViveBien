+import { supabaseAdmin } from '../auth-server'
+import { FLAGS_APAGADOS, normalizarFlags, type Flags } from './flags'
+
+/**
+ * Lectura de los feature flags CON su estado (QA-019). **Sólo servidor** (usa la service role).
+ *
+ * Por qué existe: `leerFlags` siempre devolvió «todo apagado» cuando la base no respondía. Para los permisos eso es lo correcto (falla
+ * cerrado), pero el portal lo trataba igual que «cerrado a propósito» y respondía 404 a un cliente con sesión mientras la base estaba
+ * caída: fingía que la página no existía. Aquí se distingue:
+ *
+ *   · `legibles: true`  → la base contestó (o no hay fila de flags: todos nacen apagados). Lo que digan `flags` es la verdad.
+ *   · `legibles: false` → hubo error, excepción, tiempo agotado o un valor que no es un objeto. `flags` viene TODO APAGADO (nunca se
+ *                         abre nada por un error), pero quien necesite decir la verdad al usuario sabe que no es una decisión.
+ *
+ * Este archivo NO lleva `import 'server-only'` porque también lo importa `proxy.ts` (que es el único sitio donde se puede emitir un
+ * HTTP 503: un layout ya no puede cambiar el estado una vez que empieza a transmitir). La frontera sigue protegida: una prueba
+ * (`frontera-cliente-servidor`) prohíbe que cualquier componente de cliente lo importe, y `flags-servidor.ts` conserva su marca.
+ */
+export type LecturaFlags = { flags: Flags; legibles: boolean }
+
+const VIGENCIA_MS = 60_000
+/** Un fallo se recuerda poco: cuando la base vuelve, el portal vuelve en segundos, no en un minuto. */
+const VIGENCIA_FALLO_MS = 5_000
+let memoria: { lectura: LecturaFlags; hasta: number } | null = null
+
+export async function leerFlagsConEstado(ahora = Date.now()): Promise<LecturaFlags> {
+  if (memoria && memoria.hasta > ahora) return memoria.lectura
+  let lectura: LecturaFlags = { flags: FLAGS_APAGADOS, legibles: false }
+  try {
+    const { data, error } = await supabaseAdmin()
+      .from('configuracion')
+      .select('valor')
+      .eq('clave', 'flags')
+      .maybeSingle()
+    if (!error) {
+      const valor: unknown = data?.valor
+      // Sin fila (o `null`) = nunca se configuró = todos apagados, y eso SÍ es una respuesta. Un valor que no es un objeto no se puede
+      // interpretar: no es «cerrado», es «no sé».
+      const interpretable = valor === undefined || valor === null || (typeof valor === 'object' && !Array.isArray(valor))
+      lectura = { flags: normalizarFlags(valor), legibles: interpretable }
+    }
+  } catch {
+    // Ilegible: ver arriba. Nunca abre nada.
+  }
+  memoria = { lectura, hasta: ahora + (lectura.legibles ? VIGENCIA_MS : VIGENCIA_FALLO_MS) }
+  return lectura
+}
+
+/** Olvidar lo memorizado (lo llama quien acaba de escribir un flag, para que su propia respuesta ya diga la verdad). */
+export function olvidarLecturaDeFlags(): void {
+  memoria = null
+}
