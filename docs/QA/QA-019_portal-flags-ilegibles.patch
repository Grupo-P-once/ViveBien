+import { NextResponse } from 'next/server'
+import { aperturaDelPortal } from './apertura'
+import type { LecturaFlags } from '../config/flags-lectura'
+
+/**
+ * El portal, cuando NO SE PUDO LEER su configuración (QA-019).
+ *
+ * Tres estados distintos que antes eran uno solo (404):
+ *   · `cerrado`      → la configuración se leyó y dice que nadie entra. Sigue siendo 404: no se revela que el portal existe.
+ *   · `indisponible` → la configuración NO se pudo leer (base caída, tiempo agotado, valor ilegible). 503: es un fallo temporal y
+ *                      el mensaje lo dice, en vez de fingir que la página no existe.
+ *   · `abierto`      → se leyó y hay alguna etapa abierta; quién entra lo siguen decidiendo las APIs (`exigirPortal`) y la sesión.
+ *
+ * Regla de seguridad: sólo una lectura CONFIRMADA (`legibles === true`) puede producir `cerrado` o `abierto`. Cualquier otra cosa —un
+ * `false`, un `undefined`, un objeto raro— es `indisponible`, y `indisponible` nunca abre nada: no sustituye a la autenticación ni a
+ * los permisos, sólo cambia el mensaje y el código HTTP de una página que de todos modos no se iba a mostrar.
+ */
+export type EstadoPortal = 'indisponible' | 'cerrado' | 'abierto'
+
+export function estadoDelPortal(lectura: LecturaFlags): EstadoPortal {
+  if (!lectura || lectura.legibles !== true) return 'indisponible'
+  return aperturaDelPortal(lectura.flags) === 'nadie' ? 'cerrado' : 'abierto'
+}
+
+/** Segundos que se sugiere esperar antes de reintentar (cabecera `Retry-After`). */
+export const REINTENTAR_EN_S = 30
+
+export const TITULO_NO_DISPONIBLE = 'Tu portal no está disponible por ahora'
+export const MENSAJE_NO_DISPONIBLE =
+  'No pudimos comprobar si tu portal está abierto. Es un problema temporal de nuestro lado, no de tu cuenta. Intenta de nuevo en unos minutos.'
+
+const CABECERAS = {
+  'Retry-After': String(REINTENTAR_EN_S),
+  'Cache-Control': 'private, no-store',
+  'X-Robots-Tag': 'noindex, nofollow',
+} as const
+
+/** Respuesta 503 para una PÁGINA del portal (la emite `proxy.ts`, antes de que el layout empiece a transmitir). */
+export function respuestaPortalNoDisponible(): Response {
+  const html = `<!doctype html>
+<html lang="es">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<meta name="robots" content="noindex, nofollow">
+<title>${TITULO_NO_DISPONIBLE} — Vive Bien</title>
+<style>
+:root{color-scheme:light dark;--fondo:#faf9f7;--texto:#1f1d1a;--suave:#5c5b57;--rojo:#8b1a1a}
+@media (prefers-color-scheme:dark){:root{--fondo:#16130f;--texto:#f1ede8;--suave:#b8b2a8;--rojo:#e08a8a}}
+body{margin:0;min-height:100svh;display:flex;align-items:center;justify-content:center;padding:16px;box-sizing:border-box;background:var(--fondo);color:var(--texto);font-family:system-ui,sans-serif}
+main{max-width:28rem}
+h1{font-size:1.25rem;margin:0 0 .5rem}
+p{margin:0 0 1.25rem;line-height:1.6;color:var(--suave)}
+a{display:inline-block;padding:.65rem 1.25rem;border-radius:.5rem;background:var(--rojo);color:var(--fondo);font-weight:700;text-decoration:none}
+</style>
+</head>
+<body>
+<main role="alert">
+<h1>${TITULO_NO_DISPONIBLE}</h1>
+<p>${MENSAJE_NO_DISPONIBLE}</p>
+<a href="/portal">Reintentar</a>
+</main>
+</body>
+</html>`
+  return new Response(html, { status: 503, headers: { ...CABECERAS, 'Content-Type': 'text/html; charset=utf-8' } })
+}
+
+/** Respuesta 503 para las APIs `/api/portal/*` (JSON). */
+export function respuestaApiPortalNoDisponible(): NextResponse {
+  return NextResponse.json({ error: MENSAJE_NO_DISPONIBLE }, { status: 503, headers: { ...CABECERAS } })
+}
