+import { MENSAJE_NO_DISPONIBLE, TITULO_NO_DISPONIBLE } from '@/lib/portal/no-disponible'
+
+/**
+ * Último recurso del layout del portal cuando la configuración no se pudo leer (QA-019). Normalmente `proxy.ts` ya contestó con un 503
+ * antes de llegar aquí; esto cubre la carrera en la que la lectura falla entre el proxy y el layout. Sin acciones ni datos de la cuenta.
+ */
+export default function PortalNoDisponible() {
+  return (
+    <main className="flex min-h-svh items-center justify-center bg-background p-4">
+      <div role="alert" className="max-w-md">
+        <h1 className="font-heading text-lg font-bold">{TITULO_NO_DISPONIBLE}</h1>
+        <p className="mt-2 text-sm text-muted-foreground">{MENSAJE_NO_DISPONIBLE}</p>
+        <a href="/portal" className="mt-6 inline-flex h-10 items-center rounded-md bg-primary px-5 text-sm font-bold text-primary-foreground">Reintentar</a>
+      </div>
+    </main>
+  )
+}
