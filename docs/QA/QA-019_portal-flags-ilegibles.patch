+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+import { readFileSync } from 'node:fs'
+import { join } from 'node:path'
+import { NextResponse } from 'next/server'
+
+/**
+ * QA-019 — cuando la configuración del portal NO se puede leer, no se finge un 404: se dice «no disponible por ahora» con un 503. Y un
+ * error NUNCA abre el portal.
+ */
+const bd = vi.hoisted(() => ({
+  modo: 'ok' as 'ok' | 'error' | 'excepcion' | 'sin-fila' | 'invalido' | 'sin-cliente',
+  valor: { portalCliente: false, portalClienteInterno: false } as unknown,
+  lecturas: 0,
+  exigirLlamado: 0,
+}))
+
+// El layout se EJECUTA de verdad: `notFound()` lanza (como en Next) y la carcasa del portal es un marcador.
+vi.mock('next/navigation', () => ({ notFound: () => { throw new Error('NEXT_NOT_FOUND') } }))
+vi.mock('@/components/portal/PortalShell', () => ({ default: function PortalShell() { return null } }))
+vi.mock('@/lib/auth-server', async (original) => ({
+  ...(await original<typeof import('../src/lib/auth-server')>()),
+  supabaseAdmin: () => {
+    // Sin URL o sin clave `createClient` lanza al CREAR el cliente, antes de cualquier consulta.
+    if (bd.modo === 'sin-cliente') throw new Error('supabaseUrl is required.')
+    return {
+    from: () => ({
+      select: () => ({
+        eq: () => ({
+          maybeSingle: async () => {
+            bd.lecturas++
+            if (bd.modo === 'excepcion') throw new Error('base caída')
+            if (bd.modo === 'error') return { data: null, error: { message: 'timeout' } }
+            if (bd.modo === 'sin-fila') return { data: null, error: null }
+            if (bd.modo === 'invalido') return { data: { valor: 'esto no es un objeto' }, error: null }
+            return { data: { valor: bd.valor }, error: null }
+          },
+        }),
+      }),
+    }),
+    }
+  },
+  exigir: async () => {
+    bd.exigirLlamado++
+    return { perfil: { uid: 'u', email: null, emailVerified: true, rol: 'cliente', superAdmin: false, estado: 'activo', nombre: null } }
+  },
+}))
+
+import { leerFlagsConEstado, olvidarLecturaDeFlags } from '../src/lib/config/flags-lectura'
+import { leerFlags, olvidarFlags } from '../src/lib/config/flags-servidor'
+import { FLAGS_APAGADOS } from '../src/lib/config/flags'
+import { estadoDelPortal, respuestaApiPortalNoDisponible, respuestaPortalNoDisponible } from '../src/lib/portal/no-disponible'
+import { exigirPortal } from '../src/lib/portal/exigir-portal'
+import { proxy, config as configProxy } from '../src/proxy'
+import PortalLayout from '../src/app/portal/layout'
+import PortalNoDisponible from '../src/components/portal/PortalNoDisponible'
+import { renderToStaticMarkup } from 'react-dom/server'
+
+const RAIZ = join(__dirname, '..')
+
+beforeEach(() => {
+  bd.modo = 'ok'
+  bd.valor = { portalCliente: false, portalClienteInterno: false }
+  bd.lecturas = 0
+  bd.exigirLlamado = 0
+  olvidarLecturaDeFlags()
+  vi.spyOn(console, 'error').mockImplementation(() => undefined)
+})
+afterEach(() => { vi.restoreAllMocks() })
+
+describe('leerFlagsConEstado: «cerrado» no es «no se pudo leer»', () => {
+  it('la base contesta con todo apagado → legible, cerrado (404 legítimo)', async () => {
+    const l = await leerFlagsConEstado()
+    expect(l.legibles).toBe(true)
+    expect(estadoDelPortal(l)).toBe('cerrado')
+  })
+
+  it('sin fila de flags (nunca configurados) → legible y cerrado: todos nacen apagados', async () => {
+    bd.modo = 'sin-fila'
+    const l = await leerFlagsConEstado()
+    expect(l).toEqual({ flags: FLAGS_APAGADOS, legibles: true })
+    expect(estadoDelPortal(l)).toBe('cerrado')
+  })
+
+  for (const modo of ['error', 'excepcion', 'invalido', 'sin-cliente'] as const) {
+    it(`${modo} → ILEGIBLE: todo apagado (nunca abre) pero NO es «cerrado»`, async () => {
+      bd.modo = modo
+      const l = await leerFlagsConEstado()
+      expect(l.legibles).toBe(false)
+      expect(l.flags).toEqual(FLAGS_APAGADOS)
+      expect(estadoDelPortal(l)).toBe('indisponible')
+    })
+  }
+
+  it('un error NUNCA abre el portal, ni aunque la base ya hubiera dicho «abierto» antes', async () => {
+    bd.valor = { portalCliente: true, portalClienteInterno: true }
+    expect(estadoDelPortal(await leerFlagsConEstado())).toBe('abierto')
+    olvidarLecturaDeFlags()
+    bd.modo = 'error'
+    const l = await leerFlagsConEstado()
+    expect(l.flags.portalCliente).toBe(false)
+    expect(l.flags.portalClienteInterno).toBe(false)
+    expect(estadoDelPortal(l)).toBe('indisponible')
+  })
+
+  it('la lectura abierta se memoriza 60 s; un fallo sólo 5 s (cuando la base vuelve, el portal vuelve en segundos)', async () => {
+    bd.valor = { portalCliente: true, portalClienteInterno: false }
+    await leerFlagsConEstado(1_000)
+    await leerFlagsConEstado(1_000 + 59_000)
+    expect(bd.lecturas).toBe(1)
+    await leerFlagsConEstado(1_000 + 61_000)
+    expect(bd.lecturas).toBe(2)
+
+    olvidarLecturaDeFlags(); bd.lecturas = 0; bd.modo = 'error'
+    await leerFlagsConEstado(10_000)
+    await leerFlagsConEstado(10_000 + 4_000)
+    expect(bd.lecturas).toBe(1)
+    bd.modo = 'ok'; bd.valor = { portalCliente: true, portalClienteInterno: false }
+    expect(estadoDelPortal(await leerFlagsConEstado(10_000 + 6_000))).toBe('abierto')
+  })
+
+  it('`leerFlags` (todos los demás usos) sigue fallando CERRADO: ilegible = todo apagado', async () => {
+    bd.valor = { portalCliente: true, portalClienteInterno: true }
+    bd.modo = 'excepcion'
+    expect(await leerFlags()).toEqual(FLAGS_APAGADOS)
+  })
+
+  it('`olvidarFlags` (la que usa la API de administración) también olvida la lectura con estado', async () => {
+    bd.valor = { portalCliente: true, portalClienteInterno: false }
+    await leerFlagsConEstado()
+    bd.valor = { portalCliente: false, portalClienteInterno: false }
+    olvidarFlags()
+    expect(estadoDelPortal(await leerFlagsConEstado())).toBe('cerrado')
+  })
+})
