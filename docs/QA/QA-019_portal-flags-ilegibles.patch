+describe('estadoDelPortal (puro): sólo una lectura CONFIRMADA decide', () => {
+  const ABIERTO = { portalCliente: true, portalClienteInterno: false }
+  it('matriz', () => {
+    expect(estadoDelPortal({ flags: ABIERTO as never, legibles: true })).toBe('abierto')
+    expect(estadoDelPortal({ flags: { portalCliente: false, portalClienteInterno: true } as never, legibles: true })).toBe('abierto')
+    expect(estadoDelPortal({ flags: FLAGS_APAGADOS, legibles: true })).toBe('cerrado')
+  })
+  it('ilegible → indisponible aunque los flags digan «abierto» (un error jamás abre)', () => {
+    expect(estadoDelPortal({ flags: ABIERTO as never, legibles: false })).toBe('indisponible')
+  })
+  it('valores raros en `legibles` no cuentan como confirmados', () => {
+    for (const raro of [undefined, null, 0, 1, 'true', {}, []]) {
+      expect(estadoDelPortal({ flags: ABIERTO as never, legibles: raro as never }), String(raro)).toBe('indisponible')
+    }
+    expect(estadoDelPortal(undefined as never)).toBe('indisponible')
+  })
+})
+
+describe('el proxy de /portal emite el 503 real', () => {
+  it('sólo vigila /portal y sus subrutas', () => {
+    expect(configProxy.matcher).toEqual(['/portal', '/portal/:path*'])
+  })
+
+  it('ilegible → 503 con mensaje claro, Retry-After, sin caché y sin indexar', async () => {
+    bd.modo = 'error'
+    const r = await proxy()
+    expect(r.status).toBe(503)
+    expect(r.headers.get('retry-after')).toBe('30')
+    expect(r.headers.get('cache-control')).toBe('private, no-store')
+    expect(r.headers.get('x-robots-tag')).toContain('noindex')
+    expect(r.headers.get('content-type')).toContain('text/html')
+    const html = await r.text()
+    expect(html).toContain('lang="es"')
+    expect(html).toMatch(/no está disponible por ahora/i)
+    expect(html).toMatch(/temporal/i)
+    expect(html).not.toMatch(/no encontrad|404/i) // no finge que no existe
+  })
+
+  it('cerrado confirmado → el proxy NO contesta (deja pasar: el layout responde el 404 de siempre)', async () => {
+    const r = await proxy()
+    expect(r.status).toBe(200)
+    expect(r.headers.get('x-middleware-next')).toBe('1')
+  })
+
+  it('abierto → deja pasar', async () => {
+    bd.valor = { portalCliente: true, portalClienteInterno: false }
+    const r = await proxy()
+    expect(r.headers.get('x-middleware-next')).toBe('1')
+  })
+
+  it('para todos los errores relevantes del servidor: 503 y nunca un paso libre', async () => {
+    for (const modo of ['error', 'excepcion', 'invalido', 'sin-cliente'] as const) {
+      olvidarLecturaDeFlags()
+      bd.modo = modo
+      bd.valor = { portalCliente: true, portalClienteInterno: true }
+      expect((await proxy()).status, modo).toBe(503)
+    }
+  })
+
+  it('no lee la sesión ni toca permisos', async () => {
+    bd.modo = 'error'
+    await proxy()
+    expect(bd.exigirLlamado).toBe(0)
+    const t = readFileSync(join(RAIZ, 'src', 'proxy.ts'), 'utf8')
+    expect(t).not.toMatch(/exigir|verifyIdToken|authorization|cookies/i)
+  })
+})
+
+describe('exigirPortal (todas las APIs del portal)', () => {
+  const pedir = () => exigirPortal(new Request('https://vivebienn.com/api/portal/acceso'))
+
+  it('ilegible → 503 JSON con mensaje, SIN leer la sesión y sin abrir nada', async () => {
+    bd.modo = 'error'
+    const r = await pedir()
+    expect(r.error).toBeInstanceOf(NextResponse)
+    expect(r.error!.status).toBe(503)
+    expect(r.error!.headers.get('retry-after')).toBe('30')
+    expect((await r.error!.json()).error).toMatch(/temporal/i)
+    expect(bd.exigirLlamado).toBe(0)
