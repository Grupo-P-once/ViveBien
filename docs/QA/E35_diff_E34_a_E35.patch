diff --git "a/C:\\Users\\jemil\\vivebien-deploy-stage-e35-final\\tests\\e35-fronteras.test.ts" "b/C:\\Users\\jemil\\vivebien-deploy-stage-e35-final\\tests\\e35-fronteras.test.ts"
