### src/app/api/admin/telegram/diagnostico/route.ts
diff --git "a/C:\\Users\\jemil\\vivebien-deploy-stage-e35-final\\src\\app\\api\\admin\\telegram\\diagnostico\\route.ts" "b/C:\\Users\\jemil\\vivebien-deploy-stage-e35-final\\src\\app\\api\\admin\\telegram\\diagnostico\\route.ts"
